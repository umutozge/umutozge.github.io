   "source": [
    "def pset(seq):\n",
    "    if not seq:\n",
    "        return [[]]\n",
    "    else:\n",
    "        rest = pset(seq[1:])\n",
    "        return [[seq[0]] + x for x in rest] + rest"
   ]
  }
 ],
